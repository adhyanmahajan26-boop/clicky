# Homebrew cask for Theo. Generated by Tools/install/make-cask.sh; don't edit by hand.
# Install:  brew install --cask <owner>/theo/theo
cask "theo" do
  version "@BUILD@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/build-#{version}/Theo-#{version}.zip"
  name "Theo"
  desc "Voice and screen assistant that works with your coding agents"
  homepage "https://github.com/@REPO@"

  livecheck do
    url :url
    regex(/^build-(\d+)$/i)
    strategy :github_latest
  end

  # Theo updates itself (Update now), keeping the same signature, so brew doesn't need to.
  auto_updates true
  depends_on macos: ">= :sonoma"

  app "Theo.app"

  # Theo isn't notarized (no paid Apple Developer account). Homebrew quarantines what it
  # downloads, which would make macOS refuse to open it, so the flag comes off after the
  # checksum above has been verified.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/Theo.app"]
  end

  uninstall quit: "com.personal.clicky"

  zap trash: [
    "~/.clicky",
    "~/Library/Application Support/Clicky",
    "~/Library/Application Support/Theo",
    "~/Library/Caches/com.personal.clicky",
    "~/Library/HTTPStorages/com.personal.clicky",
    "~/Library/Logs/Clicky",
    "~/Library/Preferences/com.personal.clicky.plist",
  ]
end
